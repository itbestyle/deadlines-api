# Copy to .env and fill in real values. Never commit .env.

# Required
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace_with_random_string_at_least_32_chars

# Optional
PORT=8080
EMAIL_VERIFY_BASE_URL=http://localhost:8080
FIREBASE_PROJECT_ID=

# Resend (preferred for verification email)
RESEND_API_KEY=
RESEND_FROM=Deadlines <onboarding@resend.dev>

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_MODE=auto
